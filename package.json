    "conf": "^16.0.0",
    "cosmiconfig": "^10.0.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "deepmerge": "^4.3.1",
    "dotenv": "^18.0.10",
    "fast-glob": "^3.3.3",
    "glob": "^14.0.4",
    "globby": "^16.2.4",
    "gpt-tokenizer": "^4.1.1",
    "immer": "^11.2.9",
    "joi": "^18.3.2",
    "json5": "^2.2.3",
    "kleur": "^4.1.5",
    "log-update": "^8.0.0",
    "lowdb": "^7.0.1",
    "minimatch": "^11.0.5",
    "nanoid": "^6.0.2",
